# Copy to .env. Leave a key blank to run that part offline (fixtures / fake model).

# YouTube Data API v3 key: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# Claude API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Protects the dashboard and API. Set this before you deploy anywhere public.
ADMIN_TOKEN=

# Local default is SQLite. For Supabase use the Postgres connection string, e.g.
# postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Cost caps
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_QUOTA_RESERVE=500
MONTHLY_LLM_BUDGET_USD=50
PER_RUN_LLM_BUDGET_USD=2

# Models: cheapest that does the job. Check prices at https://www.anthropic.com/pricing
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5
PRICE_FAST_IN=1.0
PRICE_FAST_OUT=5.0
PRICE_SMART_IN=3.0
PRICE_SMART_OUT=15.0

# Pipeline shape
TOP_TRENDS=10
BRIEFS_PER_RUN=3

# Optional: approved items can be POSTed here (Zapier / Make / n8n -> Metricool, LinkedIn, CMS)
PUBLISH_WEBHOOK_URL=
